PORT=3002

# Hydra admin API. Keep this private; browsers should never call it directly.
HYDRA_ADMIN_URL=http://127.0.0.1:4445

# Hydra public API used by this service to obtain an M2M token for resource-server calls.
HYDRA_PUBLIC_URL=http://127.0.0.1:4444
LOGIN_SERVER_CLIENT_ID=<hydra-client-id>
LOGIN_SERVER_CLIENT_SECRET=<hydra-client-secret>

# Resource server endpoint used to validate end-user credentials.
# If RESOURCE_SERVER_LOGIN_URL is set, it wins over RESOURCE_SERVER_URL + RESOURCE_SERVER_LOGIN_PATH.
RESOURCE_SERVER_URL=http://127.0.0.1:3003
RESOURCE_SERVER_LOGIN_PATH=/auth/login
# RESOURCE_SERVER_LOGIN_URL=http://127.0.0.1:3003/auth/login

# Request body fields sent to the resource server login endpoint.
RESOURCE_SERVER_IDENTIFIER_FIELD=email
RESOURCE_SERVER_PASSWORD_FIELD=password
RESOURCE_SERVER_AUDIENCE=resource-server
RESOURCE_SERVER_LOGIN_SCOPE=internal.auth.verify-credentials

# Field to prefer when reading the authenticated user's Hydra subject from the resource response.
# Defaults also checked: subject, sub, id, user_id, userId.
# RESOURCE_SERVER_SUBJECT_FIELD=id

# Hydra login session remember duration.
LOGIN_REMEMBER_FOR_SECONDS=3600
CONSENT_REMEMBER_FOR_SECONDS=3600
